---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
  variant: "desktop" | "mobile";
}
const { headings, variant } = Astro.props;
// Long pages (question banks with dozens of question headings) list only their sections.
const deep = headings.filter((h) => h.depth === 3).length > 30;
const items = headings.filter((h) => h.depth === 2 || (h.depth === 3 && !deep));
---

{variant === "desktop" ? (
  <nav class="toc toc--desktop" aria-label="On this page">
    <p class="toc__title">On this page</p>
    <ol>
      {items.map((h) => (
        <li style={h.depth === 3 ? "padding-left: var(--sp-3)" : undefined}>
          <a href={`#${h.slug}`}>{h.text}</a>
        </li>
      ))}
    </ol>
  </nav>
) : (
  <details class="disclosure toc toc--mobile">
    <summary>On this page</summary>
    <div>
      <ol>
        {items.map((h) => (
          <li style={h.depth === 3 ? "padding-left: var(--sp-3)" : undefined}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </div>
  </details>
)}
