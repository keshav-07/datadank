---
/**
 * A category's full question bank on one page: an anchor index of every question, a level filter, and the
 * questions as expandable answers (rendered from src/content/question-banks/). Answers are in the HTML, so
 * they are searchable and indexable while collapsed; opening #q<n> expands that answer.
 */
interface Q {
  num: number;
  title: string;
  topic: string | null;
  level: string;
}
interface Props {
  questions: Q[];
  levels: Record<string, number>;
  label: string;
}
const { questions, levels, label } = Astro.props;
const LEVELS = ["Beginner", "Intermediate", "Advanced"] as const;
// Question titles may contain `code` spans; render them as <code> in the index.
const titleHtml = (t: string) =>
  t
    .split(/(`[^`]+`)/)
    .map((p) =>
      p.startsWith("`") && p.endsWith("`")
        ? `<code>${p.slice(1, -1).replace(/&/g, "&amp;").replace(/</g, "&lt;")}</code>`
        : p.replace(/&/g, "&amp;").replace(/</g, "&lt;"),
    )
    .join("");
---

<section class="section section--tight qb" data-qb aria-labelledby="qb-index">
  <h2 id="qb-index" class="group-title">All {questions.length} {label} questions</h2>
  <div class="qb-tools js-only" role="group" aria-label="Filter questions by level">
    <button type="button" class="qb-chip" data-qb-level="" aria-pressed="true">
      All <span>{questions.length}</span>
    </button>
    {LEVELS.filter((l) => levels[l] > 0).map((l) => (
      <button type="button" class="qb-chip" data-qb-level={l} aria-pressed="false">
        {l} <span>{levels[l]}</span>
      </button>
    ))}
    <span class="qb-tools__sep" aria-hidden="true"></span>
    <button type="button" class="qb-link" data-qb-expand>Expand all</button>
    <button type="button" class="qb-link" data-qb-collapse>Collapse all</button>
  </div>
  <p class="qb-status visually-hidden" aria-live="polite" data-qb-status></p>
  <nav aria-label={`${label} questions`}>
    <ol class="qb-index" role="list">
      {questions.map((q) => (
        <li data-level={q.level}>
          <a href={`#q${q.num}`}>
            <span class="qb-index__num">Q{q.num}</span>
            <span class="qb-index__title" set:html={titleHtml(q.title)} />
          </a>
          <span class="qb-index__level">{q.level}</span>
        </li>
      ))}
    </ol>
  </nav>
  <div class="qb-list prose" data-code-root>
    <slot />
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-qb]");
  if (root) {
    const items = [...root.querySelectorAll<HTMLDetailsElement>("details.qb-item")];
    const rows = [...root.querySelectorAll<HTMLElement>(".qb-index li")];
    const status = root.querySelector<HTMLElement>("[data-qb-status]")!;

    // Open the answer a link points at (initial load, index clicks and cross-references alike).
    const openFromHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      const el = id ? document.getElementById(id) : null;
      if (el instanceof HTMLDetailsElement && el.classList.contains("qb-item")) {
        el.hidden = false;
        el.open = true;
        el.scrollIntoView();
      }
    };
    window.addEventListener("hashchange", openFromHash);
    openFromHash();

    root.querySelectorAll<HTMLButtonElement>("[data-qb-level]").forEach((btn) =>
      btn.addEventListener("click", () => {
        const level = btn.dataset.qbLevel ?? "";
        root
          .querySelectorAll<HTMLButtonElement>("[data-qb-level]")
          .forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
        let shown = 0;
        for (const el of [...items, ...rows]) {
          const hide = !!level && el.dataset.level !== level;
          el.hidden = hide;
          if (!hide && el.tagName === "DETAILS") shown++;
        }
        status.textContent = `Showing ${shown} ${level ? level.toLowerCase() + " " : ""}questions`;
      }),
    );
    const setAll = (open: boolean) => items.forEach((d) => !d.hidden && (d.open = open));
    root.querySelector("[data-qb-expand]")?.addEventListener("click", () => setAll(true));
    root.querySelector("[data-qb-collapse]")?.addEventListener("click", () => setAll(false));
  }
</script>
