---
import { getItems, getHub, techLabel } from "../../../utils/content";
import ContentLayout from "../../../layouts/ContentLayout.astro";
import IndexMeta from "../../../components/content/IndexMeta.astro";
import Tile from "../../../components/content/Tile.astro";
import QuestionTable from "../../../components/interview/QuestionTable.astro";
import Callout from "../../../components/content/Callout.astro";
import PracticeLinks from "../../../components/interview/PracticeLinks.astro";
import { HOME } from "../../../utils/breadcrumbs";
import { inLearningOrder, questionOrder } from "../../../utils/curriculum";
import { articleSchema } from "../../../utils/seo";
import { render } from "astro:content";

export async function getStaticPaths() {
  const qs = await getItems("interview-questions");
  const techs = [...new Set(qs.map((q) => q.id.split("/")[0]))];
  return techs.map((tech) => ({ params: { tech } }));
}

const ORDER = ["Easy", "Medium", "Hard"];
const { tech } = Astro.params;
const label = await techLabel(tech!);
const qs = inLearningOrder(
  tech!,
  (await getItems("interview-questions"))
    .filter((q) => q.id.startsWith(`${tech}/`))
    .sort(
      (a, b) =>
        ORDER.indexOf(a.entry.data.difficulty) - ORDER.indexOf(b.entry.data.difficulty) ||
        a.title.localeCompare(b.title),
    ),
);
const questions = await Promise.all(
  qs.map(async (item) => ({ item, Content: (await render(item.entry)).Content })),
);
const order = questionOrder(tech!);
const topicOf = order.size
  ? Object.fromEntries(qs.map((q) => [q.ref, order.get(q.ref)?.topic ?? "More"]))
  : undefined;
const articles = (await getItems("articles")).filter(
  (a) => a.technology[0] === tech && a.entry.data.section === "learn",
);
const hub = await getHub(tech!);
const title = `${label} interview questions and answers`;
const description = `${qs.length} ${label} interview questions for Data Engineers, each with a short answer, a deeper explanation, common mistakes and follow-ups.`;
const publishedDate = qs.reduce(
  (earliest, q) => (q.entry.data.publishedDate < earliest ? q.entry.data.publishedDate : earliest),
  qs[0]!.entry.data.publishedDate,
);
const updatedDate = qs.reduce(
  (latest, q) => (q.entry.data.updatedDate > latest ? q.entry.data.updatedDate : latest),
  qs[0]!.entry.data.updatedDate,
);
const schema = [
  articleSchema({
    headline: title,
    description,
    path: Astro.url.pathname,
    site: Astro.site,
    published: publishedDate,
    modified: updatedDate,
    author: "DataDank Editorial",
  }),
];
---

<ContentLayout
  title={title}
  seoTitle={`${label} Interview Questions and Answers`}
  {description}
  crumbs={[HOME, { label: "Interview", href: "/interview/" }, { label }]}
  eyebrow="Interview preparation"
  deck={`A complete, quality-led ${label} interview guide. Start with the question index, then read each answer, explanation and follow-up in this article.`}
  indexable
  ogType="article"
  {schema}
  width="reading"
>
  <IndexMeta type="Interview guide" technology={tech} />
  <section class="section section--tight" aria-labelledby="qs-h">
    <h2 id="qs-h" class="group-title">
      {label} question index
    </h2>
    <p class="muted">Choose a question to jump to its answer in this guide.</p>
    <QuestionTable questions={qs} topicOf={topicOf} caption={`${label} interview questions`} />
  </section>

  <section class="section section--tight interview-guide-answers" aria-labelledby="answers-h">
    <h2 id="answers-h" class="group-title">
      Questions and answers
    </h2>
    {questions.map(({ item, Content }, i) => {
      const d = item.entry.data;
      const slug = item.id.split("/")[1];
      return (
        <section class="section section--tight interview-guide-answer" aria-labelledby={slug}>
          <h2 id={slug}>
            <span class="muted">Question {i + 1}.</span> {item.title}
          </h2>
          <p class="eyebrow">
            {d.difficulty} · {d.questionType.join(" / ")} · ~{d.estimatedMinutes} min
          </p>
          <div class="short-answer" aria-label="Short answer">
            <h3>Short answer</h3>
            <p>{d.shortAnswer}</p>
          </div>
          <PracticeLinks link={d.practice} idPrefix={slug} />
          <div class="prose">
            <Content components={{ Callout }} />
          </div>
          {d.followUps.length > 0 && (
            <section class="related-block" aria-label="Interview follow-ups">
              <h3>Interview follow-ups</h3>
              <ol class="followups">
                {d.followUps.map((followUp) => (
                  <li>{followUp}</li>
                ))}
              </ol>
            </section>
          )}
        </section>
      );
    })}
  </section>

  {articles.length > 0 && (
    <section class="section section--tight" aria-labelledby="concept-h">
      <h2 id="concept-h" class="group-title">
        Concept review
      </h2>
      <ul class="tile-grid" role="list">
        {articles.map((a) => (
          <li>
            <Tile href={a.url} eyebrow="Lesson" title={a.title} level={a.difficulty} />
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="section section--tight" aria-labelledby="more-h">
    <h2 id="more-h" class="group-title">
      Continue preparing
    </h2>
    <ul class="tile-grid" role="list">
      {hub && (
        <li>
          <Tile
            href={hub.url}
            mono={hub.entry.data.monogram}
            eyebrow="Course"
            title={`${label} course`}
            description="Ordered lessons, projects and a cheat sheet."
          />
        </li>
      )}
      <li>
        <Tile
          href="/interview/questions/"
          eyebrow="Interview"
          title="All interview questions"
          description="Every question across all topics in one filterable list."
        />
      </li>
      <li>
        <Tile
          href="/data-engineering/system-design/"
          eyebrow="System design"
          title="Case studies"
          description="Practise full data platform designs."
        />
      </li>
      <li>
        <Tile
          href="/interview/companies/"
          eyebrow="Companies"
          title="Company preparation"
          description="Guides with attributed sources and practice questions."
        />
      </li>
    </ul>
  </section>
</ContentLayout>
